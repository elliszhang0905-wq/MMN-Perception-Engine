{"doc_id": "MMN-AUTO-0043", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "车型知识库", "module": "理想汽车", "topic": "家庭SUV标准但销量下移", "entity": "理想", "knowledge_type": "brand_judgment", "content": "理想在用户心智中仍有家庭SUV标准与社群口碑优势，但需要关注销量下移、技术炫耀与真实体验之间的落差。理想内容判断不能只看发布会技术名词，要看家庭场景是否仍成立、用户口碑是否稳定、价格带是否被竞品挤压。", "tags": ["理想", "家庭SUV", "社群口碑", "销量下移", "技术炫耀"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["理想家庭SUV心智", "理想技术炫耀风险"], "relationships": []}
{"doc_id": "MMN-AUTO-0044", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "车型知识库", "module": "岚图泰山X8", "topic": "东风体系与华为智能化", "entity": "岚图泰山X8 / 东风集团", "knowledge_type": "analysis", "content": "岚图泰山X8的配置堆叠可以从东风集团供应链逻辑解释：老牌汽车集团在白车身、金属材料、发动机、三电系统等核心硬件制造领域可以通过内部资源实现成本与匹配效率优化；智能化交给华为，硬件制造仍由东风体系掌控。传播要区分“配置多”和“调教真实表现”。", "tags": ["岚图泰山X8", "东风集团", "供应链", "华为", "硬件制造"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["岚图泰山X8东风供应链", "东风集团供应链赋能岚图"], "relationships": []}
{"doc_id": "MMN-AUTO-0045", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "上汽供应链", "topic": "华域汽车定位", "entity": "华域汽车", "knowledge_type": "definition", "content": "华域汽车应被视作上汽体系中关键的汽车零部件平台型公司，能够在内外饰、底盘、车身电子、热管理、智能座舱等方向赋能整车。营销表达不应把它讲成普通供应商，而应讲成上汽体系工程能力与规模化制造能力的一部分。", "tags": ["华域汽车", "上汽供应链", "零部件", "工程能力"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["华域汽车是什么", "华域汽车赋能上汽车型"], "relationships": []}
{"doc_id": "MMN-AUTO-0046", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "上汽供应链", "topic": "联合电子UAES", "entity": "联合电子 UAES", "knowledge_type": "definition", "content": "联合电子UAES是上汽体系中重要的汽车电子/动力系统相关配套企业，具备跨品牌供应能力。涉及联合电子时应核查具体配套项目，不要泛化为所有系统都由UAES提供。营销上可作为上汽电控与本土供应链积累的证据之一。", "tags": ["联合电子", "UAES", "上汽", "电控", "供应链"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["联合电子UAES是什么", "联合电子给哪些车企配套"], "relationships": []}
{"doc_id": "MMN-AUTO-0047", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "电池供应链", "topic": "时代上汽", "entity": "时代上汽 / 宁德时代", "knowledge_type": "definition", "content": "上汽集团与宁德时代存在合资公司“时代上汽”。涉及上汽车型电池包、宁德时代109kWh电池、麒麟电池等话题时，应区分电芯供应、模组/电池包集成、合资公司生产和品牌宣传口径，不能因为使用宁德时代电池就直接称为麒麟电池。", "tags": ["时代上汽", "宁德时代", "109kWh", "麒麟电池", "电池包"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["时代上汽是什么", "宁德时代109kWh是不是麒麟电池"], "relationships": []}
{"doc_id": "MMN-AUTO-0048", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "底盘", "topic": "空悬与CDC判断", "entity": "空气悬挂 / CDC", "knowledge_type": "technical_principle", "content": "空气悬挂优势在于高度调节、舒适性和姿态控制，但响应、耐久、维护成本与标定水平需要验证。CDC+钢簧在部分家用/性能场景下可能更直接、更稳定。不要默认空悬一定优于CDC钢簧，最终要看结构基础、控制逻辑、传感器、执行器和调校结果。", "tags": ["空气悬挂", "CDC", "钢簧", "底盘调校", "耐久"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["空悬一定比CDC好吗", "CDC钢簧和空气悬挂比较"], "relationships": []}
{"doc_id": "MMN-AUTO-0049", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "底盘", "topic": "线控底盘边界", "entity": "线控底盘", "knowledge_type": "technical_principle", "content": "线控底盘和OTA可以改变控制逻辑，但不能突破物理结构上限。轮胎、悬架几何、车身刚度、轴荷、执行器带宽、制动系统、传感器精度决定动态上限。营销上不能把“线控”讲成万能魔法，应结合实测场景证明其价值。", "tags": ["线控底盘", "OTA", "物理上限", "悬架几何", "轮胎"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["线控底盘能不能OTA提升操控", "线控底盘物理上限"], "relationships": []}
{"doc_id": "MMN-AUTO-0050", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "底盘/NVH", "topic": "高频振动与耳压区分", "entity": "NVH", "knowledge_type": "technical_principle", "content": "高频振动过滤和座舱耳压不是同一个问题。底盘把座椅振动隔绝得好，不代表车内声学舒适一定好。耳压可能与胎噪、结构传声、座舱密封、低频共振、主动降噪策略等有关。评估底盘舒适必须同时看触觉振动和听觉/NVH压力。", "tags": ["NVH", "耳压", "高频振动", "胎噪", "结构传声"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["高频振动过滤好但耳压大", "汽车耳压是什么原因"], "relationships": []}
{"doc_id": "MMN-AUTO-0051", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "轮胎", "topic": "低滚阻与湿地抓地矛盾", "entity": "新能源轮胎", "knowledge_type": "technical_principle", "content": "新能源车轮胎经常面临低滚阻、静音、耐磨、湿地抓地之间的取舍。Traction等级、配方、花纹、胎体结构与整车调校都会影响实车表现。营销对比轮胎时不能只讲品牌和尺寸，要看抓地、滚阻、噪声、耐磨和适配车型目标。", "tags": ["轮胎", "低滚阻", "湿地抓地", "Traction", "新能源"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["新能源轮胎低滚阻湿地抓地矛盾", "Traction A B是什么意思"], "relationships": []}
{"doc_id": "MMN-AUTO-0052", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "轮胎", "topic": "静音棉与轮毂/轮胎", "entity": "静音棉", "knowledge_type": "technical_principle", "content": "轮胎静音棉主要用于降低轮胎空腔共鸣与滚动噪声，但不是所有噪声都能解决。它对低频空腔噪声有效，对路面冲击、悬架传声、风噪和结构共振帮助有限。评估时要区分噪声来源，不能把静音棉当成万能降噪方案。", "tags": ["静音棉", "轮胎空腔噪声", "NVH", "胎噪"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["轮胎静音棉作用", "轮毂静音棉"], "relationships": []}
{"doc_id": "MMN-AUTO-0053", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "发动机/增程", "topic": "增程器涡轮与自然吸气", "entity": "增程器", "knowledge_type": "technical_principle", "content": "增程器是否采用涡轮增压，不能用燃油车驾驶体验逻辑判断。增程器重点是高效发电工况、NVH、热管理、体积重量、成本与稳定性。自然吸气简单可靠，但在功率密度和高效区间上可能受限；涡轮/VTG的价值要结合发电需求和控制策略判断。", "tags": ["增程器", "涡轮增压", "自然吸气", "VTG", "发电效率"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["增程器为什么用涡轮", "增程器自然吸气够不够"], "relationships": []}
{"doc_id": "MMN-AUTO-0054", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "平台架构", "topic": "欧洲PPE与中国场景差异", "entity": "大众PPE / 中国电动化平台", "knowledge_type": "analysis", "content": "欧洲高端电动平台往往更强调高速稳定、长途驾驶与工程操控；中国市场基本盘更偏城市通勤、家庭使用、120km/h限速高速、自驾出行和复杂驾驶水平差异。因此一味追求欧洲驾驶操控体验不一定符合中国市场基本盘，合资新能源必须做中国场景翻译。", "tags": ["PPE", "中国场景", "德系平台", "城市通勤", "高速"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["PPE平台适不适合中国", "欧洲驾驶场景和中国差异"], "relationships": []}
{"doc_id": "MMN-AUTO-0055", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "音响", "topic": "BOSE vs Naim车载音响判断", "entity": "BOSE Performance / Naim", "knowledge_type": "analysis", "content": "车载音响不能只看品牌名和扬声器数量。BOSE Performance在量产车适配、声场算法、整车NVH匹配上有成熟体系；Naim在宾利等高端品牌有合作，但极氪车型上的Naim是否具备核心技术深度，需要看硬件、调音、算法授权与整车适配。对比时应避免只用品牌崇拜判断。", "tags": ["BOSE", "Naim", "车载音响", "声场", "扬声器数量"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["BOSE Performance和Naim哪个好", "极氪Naim是真的Naim吗"], "relationships": []}
{"doc_id": "MMN-AUTO-0056", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "车身/安全", "topic": "A柱CBS与车身安全传播", "entity": "车身结构", "knowledge_type": "technical_marketing", "content": "车身安全传播应避免只抛材料名或结构名。若讲A柱CBS加强件、白车身、碰撞成绩或保时捷同源技术，应转译为事故场景下的乘员舱完整性、结构传力路径和用户安全感。所有具体结构来源和同源关系必须做事实核查后再对外发布。", "tags": ["A柱", "CBS", "车身安全", "白车身", "碰撞"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["A柱CBS加强件怎么讲", "车身安全传播"], "relationships": []}
{"doc_id": "MMN-AUTO-0057", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "车底结构", "topic": "底盘护板凹槽", "entity": "底盘护板", "knowledge_type": "definition", "content": "底盘护板上的规则凹槽通常用于提升板件刚性、导流、排水、避让结构、降低噪声或形成局部加强。具体作用取决于护板位置、材料和整车空气动力/NVH设计，不能看到凹槽就单一归因为散热或装饰。", "tags": ["底盘护板", "凹槽", "导流", "刚性", "NVH"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["底盘护板凹槽作用", "汽车护板为什么有凹槽"], "relationships": []}
{"doc_id": "MMN-AUTO-0058", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "电机型号", "topic": "TZ/YS命名谨慎规则", "entity": "电机型号TZ230 / YS", "knowledge_type": "definition", "content": "电机型号如TZ230、YS开头等需要按具体供应商、公告目录和命名规则核查。不要仅凭前缀做武断判断。RAG回答应提示：电机型号通常包含电机类型、尺寸、供应商/平台代号等信息，但具体含义必须对应车型公告或供应商资料。", "tags": ["电机型号", "TZ230", "YS", "公告目录", "供应商"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["TZ230电机型号含义", "YS开头电机是什么意思"], "relationships": []}
{"doc_id": "MMN-AUTO-0059", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "汽车技术知识", "module": "赛车/发动机", "topic": "保时捷718 GT4/MA2", "entity": "718 GT4 / MA2发动机", "knowledge_type": "technical_reference", "content": "718 GT4赛车和民用版本相关问题应区分Cup/Clubsport/RS/民用GT4等版本。涉及MA2发动机搭载车型、排量、动力与赛车保留原厂部件时，必须按具体年份和版本核查，不能把赛车与民用量产配置混用。", "tags": ["保时捷718 GT4", "MA2发动机", "赛车", "民用版本"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["718 GT4赛车保留原厂配置", "MA2发动机搭载车型"], "relationships": []}
{"doc_id": "MMN-AUTO-0060", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "内容与达人系统", "module": "KOC/KOL/KOS", "topic": "阶段分工", "entity": "KOL / KOC / KOS", "knowledge_type": "framework", "content": "新车上市不同阶段应使用不同角色：KOL负责破圈、背书和专业解释；KOC负责真实使用证词、场景口碑和垂类长尾扩散；KOS负责门店/销售端承接、直播、试驾邀约和本地转化。不能用KOL替代KOC，也不能用KOS承担品牌心智任务。", "tags": ["KOL", "KOC", "KOS", "上市阶段", "内容矩阵"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["新车上市KOL KOC KOS怎么分工", "KOC KOL KOS区别"], "relationships": []}
{"doc_id": "MMN-AUTO-0061", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "内容与达人系统", "module": "KOC运营", "topic": "KOC裂变飞轮", "entity": "KOC", "knowledge_type": "framework", "content": "KOC运营核心不是一次性发帖，而是裂变循环：KOC裂变出KOC，形成自我复制、自我繁殖的飞轮生态。KOL孵化灵魂在编导，KOC闭环灵魂在运营。KOC必须被任务、脚本、素材、激励、复盘和社群关系长期管理。", "tags": ["KOC", "裂变循环", "运营", "飞轮", "编导"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["KOC裂变飞轮", "KOC运营核心"], "relationships": []}
{"doc_id": "MMN-AUTO-0062", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "内容与达人系统", "module": "KOC分层", "topic": "E1-E4分层", "entity": "KOC", "knowledge_type": "framework", "content": "MMN既有KOC方法论包含E1-E4分层、圈层直连、资源置换、长效合作、内容工具赋能、流量倾斜、任务管理和分层激励。RAG应将KOC视为可运营资产，而不是一次性采买资源。", "tags": ["KOC分层", "E1", "E2", "E3", "E4", "任务管理", "分层激励"], "confidence": "medium", "source_context": "uploaded_files+conversation_memory", "status": "usable", "retrieval_queries": ["KOC E1 E4分层", "MMN KOC孵化方法论"], "relationships": []}
{"doc_id": "MMN-AUTO-0063", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "内容与达人系统", "module": "内容脚本规则", "topic": "2026汽车短视频口播", "entity": "抖音/视频号", "knowledge_type": "style_guide", "content": "2026年汽车短视频脚本要避免2018-2022年常见模板：机械拆分优缺点、过度金句、公关腔、刻意反转、开头“兄弟们”、强行炸点。更适合自然第一人称实拍语气，把技术判断嵌入真实驾驶/看车过程，保留人味和现场感。", "tags": ["2026抖音", "汽车脚本", "口播", "第一人称", "去模板化"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["2026汽车短视频脚本怎么写", "不要兄弟们开场"], "relationships": []}
{"doc_id": "MMN-AUTO-0064", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "内容与达人系统", "module": "内容选题体系", "topic": "100+选题体系", "entity": "内容选题", "knowledge_type": "framework", "content": "内容选题应覆盖上市前、中、后全周期。上市前可做价格竞猜、申报图、核心技术、预售信息；上市中做发布、配置导购、动态试驾、智能座舱、安全/续航解读；上市后做口碑、到店、用车成本、OTA、保养、车主故事、长测和竞品横评。", "tags": ["内容选题", "上市前", "上市中", "上市后", "车主口碑", "长测"], "confidence": "medium", "source_context": "uploaded_files", "status": "usable", "retrieval_queries": ["汽车内容100个选题", "新车上市内容选题体系"], "relationships": []}
{"doc_id": "MMN-AUTO-0065", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "内容与达人系统", "module": "平台表达", "topic": "垂媒用户正反向对比", "entity": "垂媒数据", "knowledge_type": "analysis_method", "content": "车型传播分析中，词云不能只做本品声量词云，应加入核心竞品词云，并做垂媒用户正反向对比。这样才能判断本品被夸/被骂的属性与竞品是否相同，进而识别传播机会和认知空位。单一词云容易造成四台车结论雷同。", "tags": ["词云", "竞品词云", "垂媒", "正反向对比", "传播建议"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["车型词云怎么做", "竞品词云正反向对比"], "relationships": []}
{"doc_id": "MMN-AUTO-0066", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "数据与自动化", "module": "抖音/小红书抓取", "topic": "工具缺口", "entity": "数据监测工具", "knowledge_type": "problem", "content": "用户当前痛点是缺少实时监测和抓取抖音、垂媒、小红书数据的工具，没有工具就像瞎子。飞瓜体验差且更偏抖音电商，不完全适配汽车内容营销。引擎需要优先支持汽车垂类视频、评论、热帖、竞品词、字幕、画面标签和达人矩阵监控。", "tags": ["数据抓取", "抖音", "小红书", "飞瓜", "垂媒", "监测"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["汽车营销数据监测工具", "飞瓜不适合汽车营销"], "relationships": []}
{"doc_id": "MMN-AUTO-0067", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "数据与自动化", "module": "Agent工作流", "topic": "每日监测日报", "entity": "AI Agent / ChatGPT / Codex", "knowledge_type": "workflow", "content": "可搭建每日早8点到晚10点定时抓取汽车评测相关视频的工作流：数据采集 → 去重清洗 → ASR字幕提取 → 画面/镜头标签 → 热度与评论分析 → 选题归纳 → 编导操作手册 → 日报推送。若无平台官方API，需要谨慎处理账号、合规、风控与稳定性。", "tags": ["AI Agent", "Codex", "日报", "ASR", "视频分析", "定时任务"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["每天抓取汽车评测视频生成日报", "ChatGPT汽车营销日报工作流"], "relationships": []}
{"doc_id": "MMN-AUTO-0068", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "数据与自动化", "module": "Codex边界", "topic": "商业化部署", "entity": "Codex生成程序", "knowledge_type": "instruction", "content": "Codex可以辅助生成爬虫、数据处理、RAG导入、前后端和自动化脚本，但正式商业化不能只依赖本地或个人账号。涉及国内客户和抖音/垂媒数据时，国内服务器、稳定代理、数据合规、账号风控、日志监控、任务队列和备份机制都要提前设计。", "tags": ["Codex", "商业化部署", "国内服务器", "数据合规", "任务队列"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["Codex做的程序商业化怎么部署", "国内服务器运行更稳吗"], "relationships": []}
{"doc_id": "MMN-AUTO-0069", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "数据与自动化", "module": "RAG训练", "topic": "导入目标系统边界", "entity": "营销引擎", "knowledge_type": "instruction", "content": "向营销引擎导入RAG前，应确认向量库、embedding模型、chunk长度、metadata字段、权限隔离、更新频率和召回测试题。不能只把文档上传后就叫训练完成；必须用典型业务问题测试：某车型问题在哪、下一周传播重点、竞品怎么打、KOC脚本怎么写。", "tags": ["RAG训练", "向量库", "embedding", "召回测试", "营销引擎"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["营销引擎RAG训练怎么导入", "RAG召回测试题"], "relationships": []}
{"doc_id": "MMN-AUTO-0070", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "合规与风险", "module": "汽车测评规范", "topic": "赛道圈速表达", "entity": "网络测评活动规范", "knowledge_type": "risk_rule", "content": "赛道圈速内容若要降低风险，应明确测试条件：赛道、日期、时间、气温、赛道温度、轮胎规格、车手同一人、SOC一致、测试流程一致。结果呈现后应讲每个赛段难度和车辆差异，避免直接价值判断“谁更好”。但只看圈速也不等于零风险，需避免误导性对比和未充分披露变量。", "tags": ["网络测评活动规范", "赛道圈速", "同一车手", "SOC", "法务风险"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["赛道圈速内容法务风险", "汽车测评规范怎么表达"], "relationships": []}
{"doc_id": "MMN-AUTO-0071", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "合规与风险", "module": "汽车测评规范", "topic": "比较测试原则", "entity": "汽车测评", "knowledge_type": "risk_rule", "content": "比较测试必须披露关键变量，尽量做到同环境、同驾驶者、同SOC/油量、同轮胎状态、同路线、同测量设备和多次取样。结论要围绕测试条件成立，不得扩大为全场景优劣。商业内容尤其要避免绝对化、贬损竞品和未经验证的安全/性能断言。", "tags": ["汽车测评", "比较测试", "变量披露", "法务风险"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["汽车比较测试合规", "汽车测评变量披露"], "relationships": []}
{"doc_id": "MMN-AUTO-0072", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "合规与风险", "module": "内容风险", "topic": "营销嫌疑与限流", "entity": "抖音平台", "knowledge_type": "risk_rule", "content": "涉及上汽体系优势、供应链背书、品牌辩护类内容，容易被平台判断为营销倾向。解决方式不是完全不讲，而是用真实车主体验、事实核查、现场验证、用户问题解决和非口号式表达降低广告感。不要用企业宣传片语言拍抖音。", "tags": ["抖音限流", "营销嫌疑", "真实车主", "供应链内容"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["抖音汽车内容营销嫌疑限流", "上汽供应链内容怎么拍不广告"], "relationships": []}
{"doc_id": "MMN-AUTO-0073", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "项目知识库", "module": "上汽大通KOC首单", "topic": "3个月60条9万", "entity": "上汽大通KOC", "knowledge_type": "case", "content": "上汽大通KOC首单为品牌专属KOC账号，3个月60条，预算9万。方向包括母品牌文化、新车、技术、体验和生活化。该案例可作为MMN小额试点模型：低门槛进入、验证KOC运营、沉淀账号资产，再向更高预算的车型经营方案升级。", "tags": ["上汽大通", "KOC首单", "3个月60条", "9万", "试点"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["上汽大通KOC首单", "3个月60条9万KOC"], "relationships": []}
{"doc_id": "MMN-AUTO-0074", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "项目知识库", "module": "凯迪拉克OTA5.0", "topic": "年包测算", "entity": "凯迪拉克CT5/XT5 OTA5.0", "knowledge_type": "case", "content": "凯迪拉克CT5/XT5 OTA5.0项目曾讨论年包：总投入50万、144条、目标总播放1000万，并进行CPM测算。该类项目适合作为品牌技术更新与老车主激活内容包，不能只做新功能播报，要转成车主真实体验和OTA价值感。", "tags": ["凯迪拉克", "OTA5.0", "年包", "CPM", "老车主"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["凯迪拉克OTA5.0年包", "50万144条1000万播放"], "relationships": []}
{"doc_id": "MMN-AUTO-0075", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "项目知识库", "module": "固特异Eagle F1", "topic": "轮胎内容与商业条款", "entity": "固特异 Eagle F1", "knowledge_type": "case", "content": "固特异Eagle F1项目涉及低滚阻与湿地抓地、配方/花纹/硅、TG、3PMSF等技术表达，并曾讨论撤单恢复与Plan B 200%违约条款。此类供应商品牌内容要把技术优势通过实测场景讲清，并提前锁定违约与交付边界。", "tags": ["固特异", "Eagle F1", "轮胎", "违约条款", "实测"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["固特异Eagle F1内容策划", "轮胎湿地抓地低滚阻"], "relationships": []}
{"doc_id": "MMN-AUTO-0076", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "行业判断", "module": "中国汽车市场", "topic": "结构与价格是核心变量", "entity": "中国汽车市场", "knowledge_type": "macro_judgment", "content": "行业不再是单纯爆发式增长，核心变量转为结构与价格。自主品牌内部竞争是主战场，纯电与插混/增程竞争进入新阶段。营销叙事要转向换购、场景、大车价值、价格与价值重构，而不是继续用泛新能源红利叙事。", "tags": ["中国汽车市场", "价格战", "换购", "场景", "结构"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["中国汽车市场2026营销核心变量", "自主品牌内部竞争"], "relationships": []}
{"doc_id": "MMN-AUTO-0077", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "行业判断", "module": "合资新能源", "topic": "旧资产必须新能源化翻译", "entity": "合资品牌", "knowledge_type": "principle", "content": "合资新能源不能继续讲旧资产。德系/美式/豪华/品质/安全这些词必须翻译成新能源场景：智能化、家庭使用、长途补能、底盘舒适、安全冗余、服务网络、长期可靠和换购理由。否则用户会认为合资只是电动化转身慢。", "tags": ["合资新能源", "德系", "美式豪华", "新能源场景", "换购"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["合资新能源怎么讲", "德系品质新能源化翻译"], "relationships": []}
{"doc_id": "MMN-AUTO-0078", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "行业判断", "module": "AI与营销", "topic": "AI替代策划落笔但不替代策略", "entity": "Gamma / AI / 策划", "knowledge_type": "principle", "content": "Gamma等AI工具可以替代PPT落笔、排版和初稿生产，但不能替代核心策略生成与策略落地审核。用户的分工应是：策略由本人输出，AI/Gamma负责PPT落地，本人最后检查、纠错、校准核心判断。", "tags": ["Gamma", "PPT", "策划", "AI", "策略审核"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["Gamma能不能替代策划", "AI替代PPT但不替代策略"], "relationships": []}
{"doc_id": "MMN-AUTO-0079", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "行业判断", "module": "汽车KOL商业化", "topic": "从粗放转向精细效率", "entity": "车垂KOL", "knowledge_type": "judgment", "content": "车垂KOL商业化不应简单判断为大幅下跌，而是从粗放投放进入差异化、精细化和效率化阶段。购买决策变长，品牌更需要能解释产品、影响试驾、沉淀口碑的内容资产，而不是只看头部达人曝光。", "tags": ["车垂KOL", "商业化", "精细化", "试驾", "口碑"], "confidence": "medium", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["车垂KOL商业化趋势", "汽车达人投放效率"], "relationships": []}
{"doc_id": "MMN-AUTO-0080", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "RAG问答规则", "module": "回答风格", "topic": "严苛压力测试", "entity": "助手输出规则", "knowledge_type": "instruction", "content": "面向用户输出汽车营销建议时，应先诊断再规划，分清目标、路径、动作，并主动压力测试假设。不得无原则附和。每个结论需要尽量真实、可验证；涉及时间、型号、数据、法规、技术规格时必须核查，不能靠记忆武断输出。", "tags": ["回答规则", "压力测试", "准确性", "诊断先行"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["用户偏好的汽车营销回答方式", "严苛导师压力测试"], "relationships": []}
{"doc_id": "MMN-AUTO-0081", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "RAG问答规则", "module": "内容禁忌", "topic": "避免ChatGPT口吻", "entity": "汽车短视频", "knowledge_type": "style_guide", "content": "用户强烈排斥“人机表达”和ChatGPT口吻。汽车脚本中避免“炸、稳、兄弟们、直接封神、闭眼入、颠覆认知”等模板词。表达要像真实创作者在现场思考和讲述，而不是公关稿或AI提纲。", "tags": ["脚本禁忌", "人机表达", "ChatGPT口吻", "抖音"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["不要ChatGPT口吻汽车脚本", "汽车短视频禁用词"], "relationships": []}
{"doc_id": "MMN-AUTO-0082", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "RAG问答规则", "module": "报告交付", "topic": "周度报告固定格式", "entity": "上汽周报", "knowledge_type": "instruction", "content": "周度上汽报告固定包含两部分：每周中国汽车市场热点事件/高声量事件，按品牌归类；针对当周上汽集团重点监测车型，做传播分析及策略定制。若用户未更新车型名单，则沿用上一版重点车型名单。周报以后通常需要可交付为Gamma/PPT。", "tags": ["周度报告", "上汽集团", "固定模板", "Gamma", "重点车型"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["上汽周度报告固定格式", "每周汽车市场热点和上汽车型策略"], "relationships": []}
{"doc_id": "MMN-AUTO-0083", "corpus_version": "v1_20260624", "created_at": "2026-06-24", "domain": "RAG问答规则", "module": "PPT第二页四车诊断", "topic": "四车词云与营销建议", "entity": "ID.ERA9X / E7X / LS8 / 至境E7", "knowledge_type": "instruction", "content": "四车同页诊断时，不能让四台车词云雷同。每台车应保留源文件本品词云，同时增加核心竞品词云、垂媒用户正反向对比和每车营销建议空间。第二页核心要呈现四车一句话问题、传播阶段判断、竞品压力和下一步动作。", "tags": ["PPT", "词云", "四车诊断", "竞品词云", "营销建议"], "confidence": "high", "source_context": "conversation_memory", "status": "usable", "retrieval_queries": ["四台车词云雷同怎么改", "PPT第二页四车营销建议"], "relationships": []}
