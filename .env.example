MMN_ENV=production
MMN_IMAGE_TAG=latest
MMN_HOST=0.0.0.0
MMN_PORT=8765
MMN_HTTP_PORT=8765
MMN_PUBLIC_BASE_URL=http://YOUR_ECS_PUBLIC_IP:8765
MMN_ALLOWED_CIDR=YOUR_OFFICE_PUBLIC_IP/32
MMN_AUTO_OPEN_BROWSER=false
MMN_DESKTOP_BRIDGE_ENABLED=false
MMN_CLOUD_LOGIN_REQUIRED=true
MMN_AUTH_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET
MMN_SCHEDULER_SECRET=CHANGE_THIS_SEPARATE_LONG_RANDOM_SECRET
MMN_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
MMN_ADMIN_USERNAME=Ellis
MMN_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
MMN_TRIAL_USERNAME=MMN
MMN_TRIAL_PASSWORD=CHANGE_THIS_TRIAL_PASSWORD
MMN_VEHICLE_ASSET_SYNC_DAY=01
MMN_VEHICLE_ASSET_SYNC_TIME=03:10
MMN_VEHICLE_ASSET_SOURCE_URL=https://caropen.api.autohome.com.cn/v1/carprice/tree_menu
MMN_DATA_ROOT=/app/data
# 兼容旧部署；新模块只读取 MMN_DATA_ROOT
MMN_DATA_DIR=/app/data
MMN_BACKUP_ROOT=/app/backups
MMN_DB_PATH=/app/data/commercial_demo.db

POSTGRES_DB=mmn
POSTGRES_USER=mmn
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DATABASE_URL=postgresql://mmn:CHANGE_THIS_STRONG_PASSWORD@mmn-db:5432/mmn
REDIS_URL=redis://redis:6379/0
MMN_CREATOR_DB_PATH=/app/data/creator_distillation.db

# TikHub 平台适配层：endpoint JSON 可按版本切换，业务代码不写死字段。
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_TIMEOUT_SECONDS=30
TIKHUB_DOUYIN_VERSION=v1
TIKHUB_XIAOHONGSHU_VERSION=v1
TIKHUB_DOUYIN_ENDPOINTS=
TIKHUB_XIAOHONGSHU_ENDPOINTS=
MMN_CREATOR_COMMENT_ASSET_LIMIT=3
MMN_CREATOR_COMMENTS_PER_ASSET=20
MMN_CREATOR_MEDIA_ASSET_LIMIT=3
MMN_CREATOR_ASR_MODEL=qwen3-asr-flash
MMN_CREATOR_ASR_API_KEY=
MMN_CREATOR_ASR_FILETRANS_MODEL=qwen3-asr-flash-filetrans
MMN_CREATOR_ASR_FILETRANS_API_KEY=
MMN_CREATOR_VISION_MODEL=qwen3.7-plus
MMN_CREATOR_VISION_API_KEY=
MMN_CREATOR_VISION_FAST_MODEL=qwen3.6-flash
MMN_CREATOR_VISION_FAST_API_KEY=
MMN_CREATOR_VISION_REVIEW_MODEL=kimi/kimi-k2.6
MMN_CREATOR_VISION_REVIEW_API_KEY=
MMN_CREATOR_OCR_MODEL=qwen-vl-ocr
MMN_CREATOR_OCR_API_KEY=
MMN_CREATOR_WORKER_MODE=local
# 社媒趋势中心关键词搜索端点（可在 TikHub 版本升级时仅改环境变量）。
TIKHUB_SOCIAL_DOUYIN_ENDPOINT=/api/v1/douyin/search/fetch_video_search_v2
TIKHUB_SOCIAL_XIAOHONGSHU_ENDPOINT=/api/v1/xiaohongshu/app_v2/search_notes
TIKHUB_SOCIAL_WEIBO_ENDPOINT=/api/v1/weibo/web/fetch_search

# MMN public-social evidence V2 (disabled unless explicitly enabled)
MMN_SOCIAL_EVIDENCE_V2_ENABLED=false
MMN_SOCIAL_EVIDENCE_SHADOW_MODE=false
# off | thread (local proof only) | external (recommended deployment)
MMN_SOCIAL_EVIDENCE_WORKER_MODE=off
MMN_SOCIAL_EVIDENCE_DB=data/social_evidence.sqlite
MMN_SOCIAL_EVIDENCE_RAW_DIR=data/social_evidence_raw
MMN_SOCIAL_EVIDENCE_ESTIMATED_UNIT_COST=1
MMN_SOCIAL_EVIDENCE_ORG_DAILY_COST_LIMIT=500
MMN_DOUYIN_COVER_PROMPT_ENABLED=false
MMN_MEDIA_ROOT=/app/data/creator_media
MMN_YTDLP_FALLBACK_ENABLED=false
SENSEVOICE_MODEL_PATH=
WHISPER_FALLBACK_ENABLED=true

# Langfuse 仅记录脱敏证据、提示词版本、模型、耗时、成本与人工修正。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MMN_CREATOR_PROMPT_VERSION=creator-dna-v1

BACKUP_DIR=backups

# 管理层集团看板刷新：周二00:00抓取官方车市扫描；未发布时周二至周五09:00补抓。
# 指标固定读取乘联分会“周度分析 / 车市扫描”列表，按官网原始口径展示为月内累计，并单列对应自然周。
MMN_GROUP_WEEKLY_REFRESH_TIME=00:00
MMN_GROUP_WEEKLY_RETRY_TIME=09:00
MMN_SALES_WARNING_REFRESH_TIME=09:15
# 本地默认自动发现同级 mmn-dcd-sales-crawler；容器部署时需挂载并指定该目录。
MMN_DCD_CRAWLER_ROOT=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_FAST_MODEL=qwen-plus
QWEN_DEEP_MODEL=qwen3.7-max
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
KIMI_API_KEY=
KIMI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KIMI_MODEL=kimi-k2.5
KIMI_DEEP_MODEL=kimi-k2.6
MMN_VIDEO_INSIGHT_KIMI_TIMEOUT=180
